
<elements>
<!--
    //     [0] PyInt:      sends id of entity the calling char is in...ship/station/system/pos/etc
    //     [1] PyInt:       ownerID = charID of char making the bm
    //     [2] PyWString:  label (called memo in db) for the bookmark
    //     [3] PyString:  text for the note (comment) field in the bookmark
    //     [4] PyInt:        folderID bookmark is being placed into.  default=0
    -->
  <elementDef name="Call_BookmarkLocation">
    <tupleInline>
        <int name="itemID" />
        <int name="ownerID" />
        <wstring name="memo" />
        <string name="comment" />
    </tupleInline>
  </elementDef>

  <elementDef name="Rsp_BookmarkLocation">
    <tupleInline>
        <int name="bookmarkID" />
        <raw name="itemID" />
        <int name="typeID" />
        <real name="x" />
        <real name="y" />
        <real name="z" />
        <int name="locationID" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_UpdateBookmark">
    <tupleInline>
        <int name="bookmarkID" />
        <int name="ownerID" />
        <wstring name="memo" />
        <string name="note" />
        <int name="folderID" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_UpdateFolder">
    <tupleInline>
        <int name="ownerID" />
        <int name="folderID" />
        <string name="name" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_BookmarkScanResult">
    <tupleInline>
        <int name="locationID" />
        <string name="memo" />
        <wstring name="note" />
        <string name="scanID" />
        <int name="ownerID" />
    </tupleInline>
  </elementDef>

</elements>