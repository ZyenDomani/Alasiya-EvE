

<elements>

  <elementDef name="SetTowerNotification">
    <tupleInline>
      <int name="structureID" />
      <bool name="showInCalendar" />
      <bool name="sendFuelNotifications" />
    </tupleInline>
  </elementDef>

  <elementDef name="SetTowerSentrySettings">
    <tupleInline>
      <int name="structureID" />
      <real name="standing" />
      <real name="status" />
      <bool name="statusDrop" />
      <bool name="corpWar" />
      <int name="standingOwnerID" />
    </tupleInline>
  </elementDef>

  <elementDef name="SetTowerPassword">
    <tupleInline>
      <int name="towerID" />
      <string name="password" />
      <bool name="allowCorp" none_marker="0" />
      <bool name="allowAlliance" none_marker="0" />
    </tupleInline>
  </elementDef>

</elements>