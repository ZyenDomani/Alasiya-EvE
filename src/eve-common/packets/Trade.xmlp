<elements>

  <elementDef name="InitiateTradeRsp_WithCash" decode="false">
    <objectInline>
      <stringInline value="util.Moniker" />
      <tupleInline>
        <stringInline value="trademgr" />
        <int name ="nodeID" />
        <tupleInline>
          <int name="stationID" />
          <tupleInline>
            <int name="myID" />
            <int name="herID" />
          </tupleInline>
          <tupleInline>
            <real name="myMoney" />
            <real name="herMoney" />
          </tupleInline>
          <int name="state" none_marker="0" />
          <long name="when" none_marker="0" />
        </tupleInline>
        <int name="unk2" none_marker="0" />
      </tupleInline>
    </objectInline>
  </elementDef>

  <elementDef name="InitiateTradeRsp_NoCash" decode="false">
    <objectInline>
      <stringInline value="util.Moniker" />
      <tupleInline>
        <stringInline value="trademgr" />
        <int name ="nodeID" />
        <tupleInline>
          <int name="stationID" />
          <tupleInline>
            <int name="myID" />
            <int name="herID" />
          </tupleInline>
          <int name="money" none_marker="0" />
          <int name="state" none_marker="0" />
          <long name="when" none_marker="0" />
        </tupleInline>
        <int name="unk2" none_marker="0" />
      </tupleInline>
    </objectInline>
  </elementDef>

  <elementDef name="Trade_BindArgs">
    <tupleInline>
      <int name="stationID" />
      <tupleInline>
        <int name="myID" />
        <int name="herID" />
      </tupleInline>
      <real name="myMoney" none_marker="0" />
      <real name="herMoney" none_marker="0" />
      <long name="fileTime" none_marker="0" />
    </tupleInline>
  </elementDef>

  <elementDef name="TradeListRsp" decode="false">
    <objectInline>
      <stringInline value="util.Row" />
      <dictInline>
        <dictInlineEntry key="header">
          <list name="header" />
        </dictInlineEntry>
        <dictInlineEntry key="line">
          <list name="line" />
        </dictInlineEntry>
      </dictInline>
    </objectInline>
  </elementDef>

  <elementDef name="TradeListData">
    <listInline>
      <long name="tradeContainerID" />
      <listInline>
        <int name="myID" />
        <int name="herID" />
      </listInline>
      <listInline>
        <bool name="myState" />
        <bool name="herState" />
      </listInline>
      <listInline>
        <real name="myMoney" />
        <real name="herMoney" />
      </listInline>
      <objectEx name="list" type="PyObjectEx" />
    </listInline>
  </elementDef>

  <elementDef name="TradeMultiAddList">
    <tupleInline>
      <listInt name="ints" />
      <int name="contID" />
    </tupleInline>
  </elementDef>


</elements>

