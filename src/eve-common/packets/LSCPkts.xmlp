
<elements>

  <include file="packets/General.h" />

  <elementDef name="MultiChannelInfo" decode="false" >
    <objectInline>
      <stringInline value="util.Rowset" />
      <dictInline>
        <dictInlineEntry key="header">
          <listInline>
            <stringInline value="channelID" />
            <stringInline value="ownerID" />
            <stringInline value="displayName" />
            <stringInline value="motd" />
            <stringInline value="comparisonKey" />
            <stringInline value="memberless" />
            <stringInline value="password" />
            <stringInline value="mailingList" />
            <stringInline value="cspa" />
            <stringInline value="temporary" />
            <stringInline value="languageRestriction" />
            <stringInline value="groupMessageID" />
            <stringInline value="channelMessageID" />
            <stringInline value="subscribed" />
            <stringInline value="estimatedMemberCount" />
          </listInline>
        </dictInlineEntry>
        <dictInlineEntry key="RowClass">
          <tokenInline value="util.Row" />
        </dictInlineEntry>
        <dictInlineEntry key="lines">
          <list name="lines" />
        </dictInlineEntry>
      </dictInline>
    </objectInline>
  </elementDef>

  <elementDef name="MultiChannelLine" decode="false" >
    <listInline>
      <int name="channelID" />
      <int name="ownerID" />
      <raw name="displayName" />
      <string name="motd" />
      <string name="comparisonKey" />
      <bool name="memberless" default="false" />
      <string name="password" none_marker="0" />
      <bool name="mailingList" default="false" />
      <int name="cspa" />
      <bool name="temporary" default="false" />
      <bool name="languageRestriction" default="false" />
      <int name="groupMessageID" />
      <int name="channelMessageID" />
      <bool name="subscribed" default="false" />
      <int name="estimatedMemberCount" />
    </listInline>
  </elementDef>

  <elementDef name="SingleChannelInfo" decode="false" >
    <objectInline>
      <stringInline value="util.Row" />
      <dictInline>
        <dictInlineEntry key="header">
          <listInline>
            <stringInline value="channelID" />
            <stringInline value="ownerID" />
            <stringInline value="displayName" />
            <stringInline value="motd" />
            <stringInline value="comparisonKey" />
            <stringInline value="memberless" />
            <stringInline value="password" />
            <stringInline value="mailingList" />
            <stringInline value="cspa" />
            <stringInline value="temporary" />
            <stringInline value="languageRestriction" />
            <stringInline value="groupMessageID" />
            <stringInline value="channelMessageID" />
            <stringInline value="mode" />
            <stringInline value="subscribed" />
            <stringInline value="estimatedMemberCount" />
          </listInline>
        </dictInlineEntry>
        <dictInlineEntry key="line">
          <listInline>
            <int name="channelID" />
            <int name="ownerID" />
            <raw name="displayName" />
            <string name="motd" />
            <raw name="comparisonKey" />
            <bool name="memberless" default="false" />
            <string name="password" none_marker="" />
            <bool name="mailingList" default="false" />
            <int name="cspa" />
            <bool name="temporary" default="false" />
            <bool name="languageRestriction" default="false" />
            <int name="groupMessageID" none_marker="0" />
            <int name="channelMessageID" none_marker="0" />
            <bool name="subscribed" default="false" />
            <int name="estimatedMemberCount" />
          </listInline>
        </dictInlineEntry>
      </dictInline>
    </objectInline>
  </elementDef>

  <elementDef name="ChannelChars" decode="false" >
    <objectInline>
      <stringInline value="util.Rowset" />
      <dictInline>
        <dictInlineEntry key="header">
          <listInline>
            <stringInline value="charID" />
            <stringInline value="corpID" />
            <stringInline value="mode" />
            <stringInline value="allianceID" />
            <stringInline value="warFactionID" />
            <stringInline value="role" />
            <stringInline value="extra" />
          </listInline>
        </dictInlineEntry>
        <dictInlineEntry key="RowClass">
          <tokenInline value="util.Row" />
        </dictInlineEntry>
        <dictInlineEntry key="lines">
          <list name="lines" />
        </dictInlineEntry>
      </dictInline>
    </objectInline>
  </elementDef>

  <elementDef name="ChannelCharsLine" decode="false" >
    <listInline>
      <int name="charID" />
      <int name="corpID" />
      <int name="mode" />
      <int name="allianceID" />
      <int name="warFactionID" />
      <long name="role" />
      <raw name="extra" />
    </listInline>
  </elementDef>

  <elementDef name="ChannelACL" decode="false" >
    <objectInline>
      <stringInline value="util.Rowset" />
      <dictInline>
        <dictInlineEntry key="header">
          <listInline>
            <stringInline value="accessor" />
            <stringInline value="mode" />
            <stringInline value="untilWhen" />
            <stringInline value="originalMode" />
            <stringInline value="admin" />
            <stringInline value="reason" />
          </listInline>
        </dictInlineEntry>
        <dictInlineEntry key="RowClass">
          <tokenInline value="util.Row" />
        </dictInlineEntry>
        <dictInlineEntry key="lines">
          <list name="lines" />
        </dictInlineEntry>
      </dictInline>
    </objectInline>
  </elementDef>

  <elementDef name="ChannelACLLine" decode="false" >
    <listInline>
      <int name="accessor" />
      <int name="mode" />
      <long name="untilWhen" />
      <int name="originalMode" />
      <string name="admin" />
      <string name="reason" />
    </listInline>
  </elementDef>

  <elementDef name="CallJoinChannels">
    <tupleInline>
      <list name="channels" />
      <long name="role" />
    </tupleInline>
  </elementDef>

  <elementDef name="RspJoinChannels" decode="false" >
    <tupleInline>
      <substreamInline>
        <!-- list of complex elements, one for each requested channel with details about the channel -->
        <list name="channels" />
      </substreamInline>
    </tupleInline>
  </elementDef>

  <elementDef name="ChannelJoinReply" decode="false" >
    <tupleInline>
      <raw name="ChannelID" />
      <int name="ok" default="1" />
      <raw name="JoinRsp" />
    </tupleInline>
  </elementDef>

  <elementDef name="ChannelJoinOK" decode="false" >
    <tupleInline>
      <raw name="ChannelInfo" />
      <raw name="ChannelACL" />
      <raw name="ChannelChars" />
    </tupleInline>
  </elementDef>

  <elementDef name="ChannelJoinNotOK" decode="false" >
    <tupleInline>
      <string name="Error" />
      <raw name="rspDict" />
    </tupleInline>
  </elementDef>

  <elementDef name="LSCChannelMultiDesc">
    <tupleInline>
      <tupleInline>
        <string name="type" />
        <int name="id" />
      </tupleInline>
    </tupleInline>
  </elementDef>

  <elementDef name="Call_SendMessage">
    <tupleInline>
      <element name="channel" type="LSCChannelMultiDesc" />
      <wstring name="message" />
    </tupleInline>
  </elementDef>

  <elementDef name="LSC_SenderEOL" >
  <!--  charID, charName, typeID, gender, charNameID = whoEOL (GetMultiOwnersEx)-->
    <listInline>
      <int name="charID" />
      <string name="charName" />
      <int name="typeID" />
      <bool name="gender" />
      <!-- for chars, this is None; for others, it's their locale messageID -->
      <raw name="charNameID" />
    </listInline>
  </elementDef>

  <elementDef name="LSC_SenderInfo" >
  <!--  whoAllianceID, whoCorpID, whoEOL, whoRole, whoCorpRole, whoWarFactionID = who  -->
    <listInline>
      <!-- 0: whoAllianceID -->
      <int name="allianceID" none_marker="0" />
      <!-- 1: whoCorpID -->
      <int name="corpID" />
      <!-- 2: whoEOL (Extended Owner Line; could be this full EOL, or just an integer) -->
      <elementPtr type="LSC_SenderEOL" name="whoEOL" />
      <!-- 3: whoRole (Mode here) -->
      <long name="chatMode" />
      <!-- 4: whoCorpRole -->
      <long name="corpRole" />
      <!-- 5: not sure its factionID -->
      <raw name="factionID" />
    </listInline>
  </elementDef>

  <elementDef name="LSC_SendMessage" >
    <tupleInline>
      <!-- 0: channel ID, either an int, or an LSCChannelMultiDesc  -->
      <raw name="channelID" />
      <!-- 1 -->
      <int name="memberCount" />
      <!-- 2 -->
      <stringInline value="SendMessage" />
      <!-- 3: sender info -->
      <elementPtr type="LSC_SenderInfo" name="sender" />
      <!-- 4 -->
      <tupleInline>
        <!-- 0 -->
        <string name="message" />
      </tupleInline>
    </tupleInline>
  </elementDef>

  <elementDef name="LSC_JoinChannel">
    <tupleInline>
      <!-- 0: channel ID, either an int, or an LSCChannelMultiDesc  -->
      <raw name="channelID" />
      <!-- 1 -->
      <int name="memberCount" />
      <!-- 2 -->
      <stringInline value="JoinChannel" />
      <!-- 3: sender info -->
      <elementPtr type="LSC_SenderInfo" name="sender" />
      <!-- 4 -->
      <raw name="args" />
    </tupleInline>
  </elementDef>

  <elementDef name="LSC_DestroyChannel">
    <tupleInline>
      <!-- 0: channel ID, either an int, or an LSCChannelMultiDesc  -->
      <raw name="channelID" />
      <!-- 1 -->
      <int name="memberCount" />
      <!-- 2 -->
      <stringInline value="DestroyChannel" />
      <!-- 3: sender info -->
      <elementPtr type="LSC_SenderInfo" name="sender" />
      <!-- 4 -->
      <raw name="args" />
    </tupleInline>
  </elementDef>

  <elementDef name="LSC_LeaveChannel">
    <tupleInline>
      <!-- 0: channel ID, either an int, or an LSCChannelMultiDesc  -->
      <raw name="channelID" />
      <!-- 1 -->
      <int name="memberCount" />
      <!-- 2 -->
      <stringInline value="LeaveChannel" />
      <!-- 3: sender info -->
      <elementPtr type="LSC_SenderInfo" name="sender" />
      <!-- 4 -->
      <raw name="args" />
    </tupleInline>
  </elementDef>

  <!-- this is probably wrong... -->
  <elementDef name="LSC_InviteNotification">
    <tupleInline>
      <raw name="channelID" />
      <int name="inviterID" />
      <string name="inviterName" />
      <bool name="isPrivateConvo" />
    </tupleInline>
  </elementDef>

  <elementDef name="CallLeaveChannel" encode="false" >
    <tupleInline>
      <raw name="channel" />
      <int name="unsubscribe" />
    </tupleInline>
  </elementDef>

  <elementDef name="CallLeaveChannels" encode="false" >
    <tupleInline>
      <list name="channels" />
      <bool name="unsubscribe" />
      <long name="role" />
    </tupleInline>
  </elementDef>

  <elementDef name="CallGetMembers" encode="false" >
    <tupleInline>
      <!-- 0 -->
      <raw name="channel" />
    </tupleInline>
  </elementDef>

  <elementDef name="CallAccessControl" encode="false" >
    <tupleInline>
      <raw name="channelID" />
      <int name="accessorID" />
      <int name="mode" />
      <long name="untilWhen" none_marker=0 />
      <string name="reason" none_marker="" />
    </tupleInline>
  </elementDef>

  <elementDef name="CallInvite" encode="false" >
    <tupleInline>
      <int name="otherID" />
      <int name="channelID" />
      <string name="channelName" />
      <bool name="addAllowed" none_marker="false" />
    </tupleInline>
  </elementDef>

  <elementDef name="CallCreateChannel" encode="false" >
    <tupleInline>
      <string name="channelName" />
      <bool name="joinExisting" none_marker="false" />
      <bool name="temporary" none_marker="false" />
      <bool name="noCallThrottling" none_marker="false" />
    </tupleInline>
  </elementDef>

  <elementDef name="RspAccessControlList" decode="false" >
    <tupleInline>
      <int name="accessorID" />
      <int name="mode" />
      <long name="untilWhen" />
      <int name="originalMode" />
      <string name="reason" />
      <int name="adminID" />
    </tupleInline>
  </elementDef>

</elements>

