      <string name="div6" none_marker="*none*" />
      <string name="div7" none_marker="*none*" />
      <string name="wallet1" none_marker="*none*" />
      <string name="wallet2" none_marker="*none*" />
      <string name="wallet3" none_marker="*none*" />
      <string name="wallet4" none_marker="*none*" />
      <string name="wallet5" none_marker="*none*" />
