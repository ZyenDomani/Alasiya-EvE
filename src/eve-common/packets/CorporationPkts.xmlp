    </tupleInline>
  </elementDef>

  <elementDef name="Call_UpdateMember" encode="false">
    <tupleInline>
      <int name="charID" />
      <string name="title" none_marker="*none*" />
      <int name="divisionID" none_marker="0" />
      <int name="squadronID" none_marker="0" />
      <long name="roles" none_marker="0" />
      <long name="grantableRoles" none_marker="0" />
      <long name="rolesAtHQ" none_marker="0" />
      <long name="grantableRolesAtHQ" none_marker="0" />
      <long name="rolesAtBase" none_marker="0" />
      <long name="grantableRolesAtBase" none_marker="0" />
      <long name="rolesAtOther" none_marker="0" />
      <long name="grantableRolesAtOther" />
      <int name="baseID" none_marker="0" />
      <long name="titleMask" none_marker="0" />
      <bool name="blockRoles" none_marker="0" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_UpdateTitle" encode="false">
    <tupleInline>
      <object name="object" type="PyObject" optional="true" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_UpdateTitleData" encode="false">
    <tupleInline>
      <int name="titleID" />
      <string name="titleName" none_marker="*none*" />
      <long name="roles" none_marker="0" />
      <long name="grantableRoles" none_marker="0" />
      <long name="rolesAtHQ" none_marker="0" />
      <long name="grantableRolesAtHQ" none_marker="0" />
      <long name="rolesAtBase" none_marker="0" />
      <long name="grantableRolesAtBase" none_marker="0" />
      <long name="rolesAtOther" none_marker="0" />
      <long name="grantableRolesAtOther" none_marker="0" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_InsertVoteCase" encode="false">
    <tupleInline>
      <string name="voteCaseText" none_marker="*none*" />
      <string name="description" none_marker="*none*" />
      <int name="corporationID" />
      <int name="voteType" none_marker="0" />
      <object name="voteCaseOptions" type="PyObject" optional="true" />
      <long name="startDateTime" none_marker="0" />
      <long name="endDateTime" none_marker="0" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_GetVoteCases" encode="false">
    <tupleInline>
      <int name="corpid" none_marker="0" />
      <int name="status" none_marker="0" />
      <int name="maxLen" none_marker="0" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_MoveShares" encode="false">
    <tupleInline>
      <int name="corporationID" />
      <int name="toShareholderID" />
      <int name="numberOfShares" />
    </tupleInline>
  </elementDef>

  <!-- this one is for updating shares owned by corp.  it sends to all online corp members as ("OnShareChange", "*corpid&corprole") -->
  <elementDef name="OnCorpShareChange" decode="false">
    <tupleInline>
      <int name="ownerID" />
      <int name="corpID" />
      <dictInline>
        <dictInlineEntry key="shares">
          <tupleInline>
            <int name="oldShares" none_marker="0" />
            <int name="newShares" none_marker="0" />
          </tupleInline>
        </dictInlineEntry>
      </dictInline>
    </tupleInline>
  </elementDef>

  <!-- this one is for updating recipient of shares as ("OnShareChange", "charid") -->
  <elementDef name="OnCharShareChange" decode="false">
    <tupleInline>
      <int name="ownerID" />
      <int name="corpID" />
      <dictInline>
        <dictInlineEntry key="corporationID">
          <tupleInline>
            <int name="oldCorpID" none_marker="0" />
            <int name="newCorpID" none_marker="0" />
          </tupleInline>
        </dictInlineEntry>
        <dictInlineEntry key="shareholderID">
          <tupleInline>
            <int name="oldOwnerID" none_marker="0" />
            <int name="newOwnerID" none_marker="0" />
          </tupleInline>
        </dictInlineEntry>
        <dictInlineEntry key="shares">
          <tupleInline>
            <int name="oldShares" none_marker="0" />
            <int name="newShares" none_marker="0" />
          </tupleInline>
        </dictInlineEntry>
        <dictInlineEntry key="shareholderCorporationID">
          <tupleInline>
            <int name="newOwnerOldCorpID" none_marker="0" />
            <int name="newOwnerNewCorpID" none_marker="0" />
          </tupleInline>
        </dictInlineEntry>
      </dictInline>
    </tupleInline>
  </elementDef>

  <elementDef name="Call_CreateMedal" encode="false">
    <tupleInline>
      <string name="title" />
      <string name="description" />
      <list name="data" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_AwardMedal" encode="false">
    <tupleInline>
      <int name="medalID" none_marker="0" />
      <list name="recipientIDs" />
      <string name="reason" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_InsertVote" encode="false">
    <tupleInline>
      <int name="corpID" />
      <int name="voteCaseID" />
      <int name="voteValue" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_GetStationServiceAccessRule" encode="false">
    <tupleInline>
      <int name="stationID" />
      <int name="serviceID" />
    </tupleInline>
  </elementDef>

</elements>
