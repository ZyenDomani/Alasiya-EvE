      <int name="minMembers" none_marker="0" />
      <int name="maxMembers" none_marker="0" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_CreateRecruitmentAd" encode="false">
    <tupleInline>
      <int name="days" none_marker="0" />
