      </dictInlineEntry>
      <dictInlineEntry key="grantableRolesAtHQ">
        <tupleInline>
          <raw name="grantableRolesAtHQOld" />
          <raw name="grantableRolesAtHQNew" />
        </tupleInline>
      </dictInlineEntry>
      <dictInlineEntry key="startDateTime">
        <tupleInline>
          <raw name="startDateTimeOld" />
          <raw name="startDateTimeNew" />
        </tupleInline>
      </dictInlineEntry>
      <dictInlineEntry key="divisionID">
        <tupleInline>
          <raw name="divisionIDOld" />
          <raw name="divisionIDNew" />
        </tupleInline>
      </dictInlineEntry>
      <dictInlineEntry key="titleMask">
        <tupleInline>
          <raw name="titleMaskOld" />
          <raw name="titleMaskNew" />
        </tupleInline>
      </dictInlineEntry>
      <dictInlineEntry key="characterID">
        <tupleInline>
          <raw name="characterIDOld" />
          <raw name="characterIDNew" />
        </tupleInline>
      </dictInlineEntry>
      <dictInlineEntry key="squadronID">
        <tupleInline>
          <raw name="squadronIDOld" />
          <raw name="squadronIDNew" />
        </tupleInline>
      </dictInlineEntry>
      <dictInlineEntry key="grantableRolesAtBase">
        <tupleInline>
          <raw name="grantableRolesAtBaseOld" />
          <raw name="grantableRolesAtBaseNew" />
        </tupleInline>
      </dictInlineEntry>
    </dictInline>
  </elementDef>

  <elementDef name="OnCorpMemberChange" decode="false" >
    <tupleInline>
      <int name="charID" />
      <dictInline>
        <dictInlineEntry key="corporationID">
          <tupleInline>
            <int name="oldCorpID" />
            <int name="newCorpID" />
          </tupleInline>
        </dictInlineEntry>
        <dictInlineEntry key="startDateTime">
          <tupleInline>
            <long name="oldDate" />
            <long name="newDate" />
          </tupleInline>
        </dictInlineEntry>
        <!--  not used in this version
        <dictInlineEntry key="rowDate">
          <tupleInline>
            <long name="oldRowDate" />
            <long name="newRowDate" />
          </tupleInline>
        </dictInlineEntry>
        -->
      </dictInline>
    </tupleInline>
  </elementDef>

  <elementDef name="OnAllianceMemberChange" decode="false" >
    <tupleInline>
      <int name="allyID" />
      <int name="corpID" />
      <dictInline>
        <dictInlineEntry key="corporationID">
          <tupleInline>
            <raw name="corporationIDOld" />
            <raw name="corporationIDNew" />
          </tupleInline>
        </dictInlineEntry>
        <dictInlineEntry key="corporationName">
          <tupleInline>
            <raw name="corporationNameOld" />
            <raw name="corporationNameNew" />
          </tupleInline>
        </dictInlineEntry>
        <dictInlineEntry key="chosenExecutorID">
          <tupleInline>
            <raw name="chosenExecutorIDOld" />
            <raw name="chosenExecutorIDNew" />
          </tupleInline>
        </dictInlineEntry>
      </dictInline>
    </tupleInline>
  </elementDef>

  <elementDef name="OnTitleChanged" decode="false">
    <tupleInline>
      <int name="corpID" />
      <int name="titleID" />
      <dict name="changes" /><!-- TitleChangeData dict goes here, one for each change -->
    </tupleInline>
  </elementDef>

  <elementDef name="Notify_IntRaw" decode="false">
    <tupleInline>
      <int name="key" />
      <dict name="data" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_UpdateApplication" encode="false">
    <tupleInline>
      <int name="corpID" />
