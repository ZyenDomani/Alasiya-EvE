      <int name="status" /> <!-- ? -->
      <long name="date" none_marker="0" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_UpdateDivisionNames" encode="false">
    <tupleInline>
      <string name="div1" none_marker="*none*" />
      <string name="div2" none_marker="*none*" />
      <string name="div3" none_marker="*none*" />
      <string name="div4" none_marker="*none*" />
