  <elementDef name="Call_UpdateLogo" encode="false">
    <tupleInline>
      <int name="shape1" none_marker="0" />
      <int name="shape2" none_marker="0" />
      <int name="shape3" none_marker="0" />
      <int name="color1" none_marker="0" />
      <int name="color2" none_marker="0" />
      <int name="color3" none_marker="0" />
      <string name="typeface" none_marker="arial" /> <!-- Prolly always none -->
    </tupleInline>
  </elementDef>

  <elementDef name="Call_GetRecruitmentAdsByCriteria" encode="false">
    <tupleInline>
      <long name="typeMask" none_marker="0" />
