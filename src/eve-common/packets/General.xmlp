          <dictInlineEntry key="header">
        <raw name="header" />
          </dictInlineEntry>
        </dictInline>
      </tupleInline>
    </objectEx>
  </elementDef>

  <elementDef name="dbutil_RowList_header" encode="false" decode="false">
    <tupleInline>
     <tupleInline>
       <string name="type" none_marker="dbutil.RowList" type1="true" />
     </tupleInline>
