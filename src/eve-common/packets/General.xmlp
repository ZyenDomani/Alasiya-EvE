  <!--
  empty calls:
  CallPing
  CallGetFactionInfo
  CallGetStuckSystems
  CallGetOwnerNoteLabels
  -->

  <elementDef name="SingleIntegerArg">
    <tupleInline>
      <int name="arg" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_SingleRealArg" encode="false">
    <tupleInline>
      <real name="arg" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_TwoIntegerArgs" encode="false">
    <tupleInline>
      <int name="arg1" />
      <int name="arg2" />
    </tupleInline>
  </elementDef>

  <elementDef name="PointArg">
    <tupleInline>
      <real name="x" />
      <real name="y" />
      <real name="z" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_SingleBoolArg" encode="false">
    <tupleInline>
      <bool name="arg" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_TwoBoolArgs" encode="false">
    <tupleInline>
      <bool name="arg1" />
      <bool name="arg2" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_SingleStringArg" encode="false">
    <tupleInline>
      <string name="arg" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_SingleWStringArg" encode="false">
    <tupleInline>
      <wstring name="arg" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_SingleArg" encode="false">
    <tupleInline>
      <raw name="arg" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_SingleIntList" encode="false">
    <tupleInline>
      <listInt name="ints" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_IntBoolArg" encode="false">
    <tupleInline>
      <int name="arg1" />
      <bool name="arg2" />
    </tupleInline>
  </elementDef>


  <elementDef name="CallGetMultiOwnersEx" encode="false">
    <tupleInline>
      <!-- 0 -->
      <listInt name="entities" />
    </tupleInline>
  </elementDef>

  <elementDef name="CallMachoResolveObject" encode="false">
    <tupleInline>
      <!-- 0 -->
        <raw name="bindParams" />
      <!-- 1 -->
      <int name="justQuery" />
    </tupleInline>
  </elementDef>

  <elementDef name="CallMachoBindObject_call" encode="false">
      <tupleInline>
        <!-- 0 -->
        <string name="method_name" />
        <!-- 1 -->
        <tuple name="arguments" />
        <!-- 2 -->
        <dict name="dict_arguments" />
      </tupleInline>
  </elementDef>

  <elementDef name="CallMachoBindObject" encode="false">
    <tupleInline>
      <!-- 0 -->
        <raw name="bindParams" />
      <!-- 1 -->
        <!-- either 'None', or a CallMachoBindObject_call -->
        <raw name="call" />
    </tupleInline>
  </elementDef>

  <elementDef name="BoundObject">
      <substructInline>
        <substreamInline>
            <tupleInline>
              <!-- 0 -->
              <string name="bindspec" />
              <!-- 1 -->
              <long name="timestamp" />
            </tupleInline>
        </substreamInline>
      </substructInline>
  </elementDef>

  <elementDef name="ErrorResponse">
    <tupleInline>
      <!-- 0 -->
      <int name="MsgType" />
      <!-- 1 -->
      <int name="ErrorCode" />
      <!-- 2 -->
      <tupleInline>
        <!-- 0 -->
        <substreamInline>
          <raw name="payload" />
        </substreamInline>
      </tupleInline>
    </tupleInline>
  </elementDef>

  <elementDef name="macho_WrongMachoNode" decode="false">
    <objectInline>
        <stringInline value="macho.WrongMachoNode" />
      <dictInline>
          <dictInlineEntry key="payload">
            <int name="nodeID" />
          </dictInlineEntry>
      </dictInline>
    </objectInline>
  </elementDef>

  <elementDef name="NotifyOnAggressionChange" decode="false">
    <tupleInline>
      <!-- 0 -->
      <int name="integer0" />
      <!-- 1 -->
        <!-- maps _something_ to a timestamp -->
      <dictInt name="entries" />
    </tupleInline>
  </elementDef>

  <elementDef name="CallGetInventoryFromId" encode="false">
    <tupleInline>
        <!-- 0 -->
        <int name="entityID" />
        <!-- 1 -->
        <int name="passive" />
    </tupleInline>
  </elementDef>

  <elementDef name="CallGetMessageDetails" encode="false">
    <tupleInline>
      <!-- 0 -->
      <int name="channelID" />
      <!-- 1 -->
      <int name="messageID" />
    </tupleInline>
  </elementDef>

  <elementDef name="CallMarkMessagesRead" encode="false">
    <tupleInline>
      <!-- 0 -->
      <listInline>
        <!-- 0 -->
        <int name="messageID" />
      </listInline>
    </tupleInline>
  </elementDef>

  <elementDef name="SessionChangeNotification">
    <tupleInline>
      <long name="sessionID" none_marker="0" />
      <!-- 0 -->
      <tupleInline>
        <!-- 0 -->
        <int name="clueless" none_marker="0" />
        <!-- 1 -->
        <dict name="changes" />
      </tupleInline>
      <!-- 1 -->
      <!-- this is actually optional... -->
      <listInt name="nodesOfInterest" />
    </tupleInline>
  </elementDef>

  <elementDef name="ServerNotification">
    <tupleInline>
      <!-- 0 -->
      <tupleInline>
        <!-- 0 -->
        <int name="unknown" />
        <!-- 1 -->
        <substreamInline>
          <tupleInline>
            <!-- 0 -->
            <list name="elements" />
            <!-- 1 -->
            <string name="method" />
            <!-- 2 -->
            <tuple name="arguments" />
            <!-- 3 -->
            <dictStr name="keywords" />
          </tupleInline>
        </substreamInline>
      </tupleInline>
    </tupleInline>
  </elementDef>

  <elementDef name="ServerNotification_ReleaseObj">
    <tupleInline>
        <string name="boundID" />
        <long name="timestamp" />
    </tupleInline>
  </elementDef>

  <elementDef name="Notify_OnRemoteMessage" decode="false">
    <tupleInline>
      <string name="msgType" />
      <dictStr name="args" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_InsureShip" encode="false">
      <tupleInline>
          <int name="shipID" />
          <real name="amount" />
          <int name="isCorp" />
      </tupleInline>
  </elementDef>

  <elementDef name="Call_SearchQuery" encode="false">
      <tupleInline>
          <string name="str" />
          <listInt name="ids" />
      </tupleInline>
  </elementDef>

  <elementDef name="Call_BoardShip" encode="false">
    <tupleInline>
      <int name="newShipID" />
      <int name="oldShipID" />
    </tupleInline>
  </elementDef>

  <elementDef name="Beyonce_Formation" decode="false">
    <tupleInline>
      <!-- 0: Name of formation -->
      <string name="name" />
      <!-- 1: Tuple of positions -->
      <tupleInline>
        <element name="pos1" type="PointArg" />
        <element name="pos2" type="PointArg" />
        <element name="pos3" type="PointArg" />
        <element name="pos4" type="PointArg" />
      </tupleInline>
    </tupleInline>
  </elementDef>

  <!-- this is loaded in static data mgr, and used in corpdata, and i didnt know where it fit best, so i put it here. -->
  <elementDef name="GetFactionInfoRsp" decode="false">
    <tupleInline>
        <!-- 0: factionIDbyNPCCorpID: dict: corpID -> factionID    -->
      <dictRaw name="factionIDbyNPCCorpID" key="uint32"  pykey="Int" value="uint32" pyvalue="Int" />
        <!-- 1: factionRegions: dict: factionID -> listInt -->
      <dictInt name="factionRegions" />
        <!-- 2: factionConstellations: dict: factionID -> listInt -->
      <dictInt name="factionConstellations" />
        <!-- 3: factionSolarSystems: dict: factionID -> listInt -->
      <dictInt name="factionSolarSystems" />
        <!-- 4: factionRaces: dict: factionID -> listInt -->
      <dictInt name="factionRaces" />
        <!-- 5: factionStationCount: dict: factionID -> count -->
      <dictRaw name="factionStationCount" key="uint32"  pykey="Int" value="uint32" pyvalue="Int" />
        <!-- 6: factionSolarSystemCount: dict: factionID -> count -->
      <dictRaw name="factionSolarSystemCount" key="uint32"  pykey="Int" value="uint32" pyvalue="Int" />
        <!-- 7: npcCorpInfo: dict: corpID -> util.Row -->
      <!--
          corporationName,
          corporationID,mainActivityID,secondaryActivityID,
          size,extent,solarSystemID,investorID1,investorShares1,investorID2,
          investorShares2,investorID3,investorShares3,investorID4,investorShares4,
          friendID,enemyID,publicShares,initialPrice,minSecurity,scattered,
          fringe,corridor,hub,border,factionID,sizeFactor,stationCount,
          stationSystemCount,stationID,ceoID,ceoName
      -->
      <raw name="npcCorpInfo" />
   </tupleInline>
  </elementDef>

</elements>
