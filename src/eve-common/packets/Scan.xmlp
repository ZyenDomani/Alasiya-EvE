-->
<!--
  <elementDef name="ScanProbesDict">
      <objectInline>
        <stringInline value="util.KeyVal" />
          <dictInline>
            <dictInlineEntry key="typeID">
              <int name="typeID" />
            </dictInlineEntry>
            <dictInlineEntry key="probeID">
              <int name="probeID" />
            </dictInlineEntry>
            <dictInlineEntry key="scanStrength">
              <real name="scanStrength" />
            </dictInlineEntry>
            <dictInlineEntry key="target">
              <objectEx name="target" type="PyFloat">
            </dictInlineEntry>
            <dictInlineEntry key="rangeStep">
              <int name="rangeStep" />
            </dictInlineEntry>
            <dictInlineEntry key="pos">
              <objectEx name="pos" type="PyFloat" />
            </dictInlineEntry>
            <dictInlineEntry key="expiry">
              <int name="expiry" />
            </dictInlineEntry>
            <dictInlineEntry key="state">
              <int name="probeState" none_marker="0" />
            </dictInlineEntry>
            <dictInlineEntry key="maxDeviation">
              <real name="maxDeviation" />
            </dictInlineEntry>
            <dictInlineEntry key="scanRange">
              <real name="scanRange" />
            </dictInlineEntry>
          </dictInline>
      </objectInline>
  </elementDef>
-->
