

<elements>

  <elementDef name="Call_PlaceCharOrder">
    <tupleInline>
      <int name="stationID" />
      <int name="typeID" />
      <real name="price" />
      <int name="quantity" />
      <int name="bid" safe="true" /><!-- integer boolean -->
      <int name="orderRange" />
      <int name="itemID" none_marker="0" />
      <int name="minVolume" />
      <int name="duration" /> <!-- in days -->
      <int name="useCorp" safe="true" /><!-- integer boolean -->
      <tuple name="located" optional="true" /><!-- tuple for corp items in corp office.  none otherwise. -->
    </tupleInline>
  </elementDef>

  <elementDef name="Call_ModifyCharOrder">
    <tupleInline>
      <int name="orderID" />
      <real name="newPrice" />
      <bool name="bid" safe="true" />
      <int name="stationID" />
      <int name="solarSystemID" />
      <real name="price" />
      <int name="range" />
      <int name="volRemaining" />
      <long name="issueDate" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_CancelCharOrder">
    <tupleInline>
      <int name="orderID" />
      <int name="regionID" />
    </tupleInline>
  </elementDef>

  <elementDef name="Notify_OnOwnOrderChanged">
    <tupleInline>
      <raw name="order" />
      <!-- Reason: Add or Expiry (probably a "Change" or something too) -->
      <string name="reason" />
      <bool name="isCorp" />
    </tupleInline>
  </elementDef>

  <elementDef name="Call_GetNewCharTransactions">
    <tupleInline>
      <int name="buySell" none_marker="-1" />
      <int name="typeID" none_marker="0" />
      <int name="clientID" none_marker="0" />
      <int name="quantity"/>
      <long name="fromDate" none_marker="0" />
      <real name="maxPrice" none_marker="0" />
      <raw name="minPrice"/>
    </tupleInline>
  </elementDef>

  <elementDef name="Call_GetNewCorpTransactions">
    <tupleInline>
      <int name="buySell" none_marker="-1" />
      <int name="typeID" none_marker="0" />
      <int name="clientID" none_marker="0" />
      <int name="quantity"/>
      <long name="fromDate" none_marker="0" />
      <real name="maxPrice" none_marker="0" />
      <raw name="minPrice"/>
      <int name="accountKey" none_marker="1000" />
      <int name="memberID" none_marker="0" />
    </tupleInline>
  </elementDef>

</elements>


