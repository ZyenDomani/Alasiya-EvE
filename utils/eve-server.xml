<!--  notes here
    unless otherwise noted, ALL fractional values use fuzzy logic.
-->

<eve-server>

    <server>
        <testServer>1</testServer>  <!-- some functions disabled for live server -->
        <UseBeanCount>1</UseBeanCount>  <!-- bool  -client error reporting -->
        <UseProfiling>0</UseProfiling><!-- bool -->
        <UseAPIServer>0</UseAPIServer><!-- bool -->
        <!--  BE VERY CAREFUL WITH THE SETTING BELOW! This will create a jetcan at player's ship position every tic while ship is moving -->
        <UseShipTracking>0</UseShipTracking><!-- bool -->
        <!--  This changes how the main server loop sleeps (loop count) -->
        <ServerSleepTime>10</ServerSleepTime><!-- server sleep time in ms -->
        <maxPlayers>2500</maxPlayers>
    </server>

    <world>
    <!-- not implemented yet -->
        <chatLogs>0</chatLogs><!-- bool -->
        <globalChat>1</globalChat><!-- bool -->
        <!-- grid Unloading is implemented -->
        <gridUnload>1</gridUnload><!-- bool -->
        <gridUnloadTime>300</gridUnloadTime><!-- in seconds (5 min default)-->
        <loginInfo>1</loginInfo><!-- bool -->
        <loginMsg>1</loginMsg><!-- bool -->
        <mailDeliveryDelay>5</mailDeliveryDelay>
        <idleSleepTime>1000</idleSleepTime><!-- in ms (1 sec default) -->
    </world>

    <rates>
        <secRate>1.0</secRate><!--  only used if != 1.0 -->
        <damageRate>1.0</damageRate><!--  ALL damage. only used if != 1.0 -->
        <missileRate>1.0</missileRate><!--  ALL missiles. only used if != 1.0 -->
        <missileTime>1.0</missileTime><!--  ALL missiles. only used if != 1.0 -->
        <turrentRate>1.0</turrentRate><!--  PC turrents. only used if != 1.0 -->
        <missileRoF>1.1</missileRoF><!-- ALL missiles. only used if != 1.0 -->
        <turrentRoF>1.1</turrentRoF><!-- PC turrents. only used if != 1.0 -->
        <npcBountyMultiply>1.0</npcBountyMultiply><!--  only used if != 1.0 -->
        <corpCost>20000000</corpCost>
        <processTic>1.0</processTic><!-- used to slow down server process tics.  <1.0 is faster, >1.0 slower -->
        <!-- Decay is implemented -->
        <WorldDecay>120</WorldDecay><!-- in minutes (2 hour default) -->
        <NPCDecay>90</NPCDecay><!-- in minutes (90 min default) -->
        <!-- WebUpdate is implemented -->
        <WebUpdate>15</WebUpdate><!-- save current server status in db.  in minutes  15m default -->
        <!-- these rates are not implemented yet -->
        <RateDropItem>1.0</RateDropItem><!--  only used if != 1.0 -->
        <RateDropMoney>1.0</RateDropMoney><!--  only used if != 1.0 -->
        <RepairCost>1.0</RepairCost><!--  only used if != 1.0 -->
    </rates>

