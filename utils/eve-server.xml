    <character>
        <startBalance>600000000.0</startBalance>
        <startAurBalance>600.0</startAurBalance>
        <startStation>0</startStation>
        <startSecRating>1.0</startSecRating>
        <startCorporation>0</startCorporation>
        <terminationDelay>180</terminationDelay> <!-- seconds -->
    </character>

    <npc>
        <!-- Threat not implemented yet -->
        <ThreatRadius>1.0</ThreatRadius> <!-- percent of default 0.0 to 1.0 -->
        <!-- Spawn Checks and RoamingSpawns are implemented but StaticSpawns are not-->
        <RoamingSpawns>0</RoamingSpawns><!-- bool -->
        <StaticSpawns>0</StaticSpawns><!-- bool -->
        <RoamingTimer>15</RoamingTimer><!-- time between spawn checks, in minutes (initial spawn is this x3) -->
        <StaticTimer>10</StaticTimer><!-- time between spawn checks, in minutes (initial spawn is this x3) -->
    </npc>

    <database>
        <host>localhost</host>
        <username>allan</username>
