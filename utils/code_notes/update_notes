loop  (proc pLevel)
  get plant @ this plevel

  data
    get cycle count (proc times)

  loop (plant @ pLevel)
    get route using current plant as dest  (can be multiple routes)
    get route source
    if src = plant or src = ecu
	continue - mat'l type/qty (should be) already updated
    if src = storage
        get route mat'l type/qty
	check src for type/qty
	remove qty from src
	add qty to dest
	set dest mat'l received (prev cycle)

    loop [recInput prev pLevel]  (plant req mat'l)
        check plant inventory per schematic data
	    check type/qty vs cycle count and revise based on mat'l/qty in storage
	flag rec mat'l for next check

    if all req mat'l in plant storage, set recInput this pLevel
    remove prev pLevel recInput

    loop [recInput this pLevel]  (plant output mat'l)
	get route using current plant as src
	get route dest
	get route mat'l type/qty per cycle
	remove req type/qty from plant storage per cycle
	add cycle qty to dest
	remove recInput this pLevel



