// tracking within 900m for Frigates, 1k4m for BS.  05Jun17
void DestinyManager::Turn() {
    if (mySE->HasPilot())
        if (mySE->GetPilot()->IsUndock())
            return;

    if (!IsTurn()) {
        if (m_turning)
            ClearTurn();
        return;
    }

    /*when changing directions....
     * revert to previous code....it was close.
     * when turns > 90, ship slow before turning.
     *
     *
     *  m_moveTime will have to be reset - handled in UpdateVelocity()
     *  m_shipHeading will have to be reset - reset here and used in MoveObject() (our calling function)
     *  check for decel, then call UpdateVelocity() to set variables as needed.  Move() will handle the rest.
     *
     * turn time = align time  direction/angle dont matter
     *  deg/tic is based on turn angle.  is set on first hit of Turn()
     *
     * this below isnt right, hack is almost close
     *   m_degPerTic = 60.0f / m_massMKg * m_shipInertia;  ([this file]:2317, reset for ab/mwd [this file]:2154)
     *
     */

    ++m_turnTic;
    if (m_turnTic > m_alignTime) {
        m_shipHeading = m_targetHeading;
        if (is_log_enabled(DESTINY__TURN_TRACE))
            _log(DESTINY__TURN_TRACE, "Destiny::Turn() - turnTic > alignTime.  turn completed in %us", m_turnTic);
        return;
    }

    //m_radians = rad left in turn.   set in IsTurn() on every tic
    float degrees(EvE::Trig::Rad2Deg(m_radians));

    // logic to determine speed changes for turning
    // the following equation is from "Ship Motion in Eve Online" Pt2 by Scheulagh Santorine, Ph.D
    // minimum ship speed based on degree of turn and current ship speed
    //minVelocity = velocity * std::sqrt((std::cos(degrees) + 1) / 2);
    float turnPercent(std::sqrt((std::cos(degrees) + 1) / 2));
    if (!m_turning) {
        // beginning turn
        m_turning = true;
        m_degPerTic = (degrees / m_alignTime);

        // as min speed when turning occurs within first second of turn, reset ASF to min turn speed on first tic of turn
        // this isnt right....ship will slow, then turn.  will have to refigure all of this.
        m_activeSpeedFraction = m_activeSpeedFraction * (std::sqrt((std::cos(degrees) + 1) / 2));
        // UpdateVelocity(true) will reset move vars and TF.
        UpdateVelocity(true);

        if (is_log_enabled(DESTINY__TURN_TRACE)) {
            _log(DESTINY__TURN_TRACE, "Destiny::Turn() - %s(%u): Agility:%.3f, Inertia:%.3f, alignTime:%.3f, ASF:%.3f, m_degPerTic:%.3f", \
                    mySE->GetName(), mySE->GetID(), m_shipAgility, m_shipInertia, m_alignTime, m_activeSpeedFraction, m_degPerTic);
        }
    }

    // set ship turn amount based on position in turn, current speed and ship agility
    GVector deltaHeading(m_shipHeading, m_targetHeading);
    deltaHeading *= turnPercent;
    m_shipHeading += deltaHeading;
    if (is_log_enabled(DESTINY__TURN_TRACE))
        _log(DESTINY__TURN_TRACE, "Destiny::Turn() - tf:%.3f, turnTic:%u, degRemain:%.3f  (deltaHeading:%.5f, %.5f, %.5f * turnPercent:%.2f) = shipHeading:%.3f, %.3f, %.3f", \
            m_timeFraction, m_turnTic, degrees, deltaHeading.x, deltaHeading.y, deltaHeading.z, turnPercent, m_shipHeading.x, m_shipHeading.y, m_shipHeading.z);
}
